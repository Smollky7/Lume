# Copie para .env e ajuste. Todas as variáveis são opcionais.

PORT=3000
HOST=0.0.0.0

# Máximo de espectadores por sala (modo P2P: cada espectador consome upload do anfitrião)
MAX_VIEWERS=8

# --- STUN / TURN -----------------------------------------------------------
# STUN público (padrão: servidores do Google)
# STUN_URLS=stun:stun.l.google.com:19302

# TURN com credenciais fixas (ex.: provedor TURN gerenciado):
# TURN_URLS=turn:SEU_HOST:3478?transport=udp,turn:SEU_HOST:3478?transport=tcp,turns:SEU_HOST:5349?transport=tcp
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha

# TURN próprio (coturn com use-auth-secret): credenciais temporárias geradas pelo servidor
# TURN_URLS=turn:turn.seudominio.com:3478?transport=udp,turns:turn.seudominio.com:5349?transport=tcp
# TURN_SECRET=um-segredo-longo-e-aleatorio

# TURN gerenciado da Cloudflare (Realtime TURN) — o servidor gera credenciais temporárias sozinho.
# Crie uma "TURN key" no painel da Cloudflare (Realtime > TURN) e cole aqui:
# CF_TURN_KEY_ID=...
# CF_TURN_API_TOKEN=...

# Alternativa: qualquer API que devolva um array "iceServers" por GET (ex.: Metered).
# Use a URL completa, já com a apiKey:
# ICE_API_URL=https://SEUAPP.metered.live/api/v1/turn/credentials?apiKey=SUA_CHAVE

# Atrás de proxy/túnel (Cloudflare Tunnel, Caddy): usa o IP real nos limites de tentativas
TRUST_PROXY=true

# Origem pública do frontend. Separe por vírgula se precisar liberar mais de uma.
FRONTEND_URL=https://seu-frontend.vercel.app

# Usados apenas pelo comando opcional de registro/reparo do Entry Point do Discord.
# Nunca envie o token ao GitHub nem coloque VITE_ na frente dele.
# DISCORD_APPLICATION_ID=123456789012345678
# DISCORD_BOT_TOKEN=cole_o_token_somente_no_ambiente_local
